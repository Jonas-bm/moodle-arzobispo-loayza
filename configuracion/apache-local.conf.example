# Referencia para Apache 2.4. No es un archivo de Docker.
# Reemplazar /RUTA/PROYECTO por la ruta absoluta del proyecto.
# En Windows usar barras /: C:/proyectos/arzobispo-loaysa.
# Agregar Listen 8081 a Apache SOLO si aún no existe para ese puerto.
<VirtualHost *:8081>
    ServerName localhost
    DocumentRoot "/RUTA/PROYECTO/moodle/public"

    <Directory "/RUTA/PROYECTO/moodle/public">
        Require all granted
        AllowOverride None
        Options -Indexes
        DirectoryIndex index.php
    </Directory>

    # No publicar archivos internos de desarrollo ni pruebas.
    RedirectMatch 404 "(?i)(^|/)(vendor|node_modules|tests|fixtures|behat|\.git|\.github|\.upgradenotes)(/|$)"
    RedirectMatch 404 "(?i)(^|/)(composer\.(json|lock)|phpunit\.xml(\.dist)?|\.stylelintrc|environment\.xml|readme[^/]*|upgrade\.txt|upgrading[^/]*\.md)$"
    RedirectMatch 404 "(?i)/db/install\.xml$"
    RedirectMatch 404 "^/lib/classes/?$"
</VirtualHost>
